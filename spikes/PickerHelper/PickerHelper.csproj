<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-macos</TargetFramework>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <SupportedOSPlatformVersion>12.0</SupportedOSPlatformVersion>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Preferis.Spikes.PickerHelper</RootNamespace>
    <AssemblyName>PickerHelper</AssemblyName>
    <ApplicationTitle>PickerHelper</ApplicationTitle>
    <ApplicationId>net.mayuki.preferis.spike.picker</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Microsoft.macOS creates an installer .pkg on publish by default; we only want the .app. -->
    <CreatePackage>false</CreatePackage>
  </PropertyGroup>

  <!--
    Copy the produced .app bundle to artifacts/spikes/ after publish.
    Microsoft.macOS assembles the bundle in $(OutDir) (bin/...), not in $(PublishDir).
  -->
  <Target Name="CopyBundleToArtifacts" AfterTargets="Publish">
    <PropertyGroup>
      <ArtifactsDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'artifacts', 'spikes'))</ArtifactsDir>
    </PropertyGroup>
    <RemoveDir Directories="$(ArtifactsDir)PickerHelper.app" />
    <Exec Command="cp -R &quot;$(OutDir)PickerHelper.app&quot; &quot;$(ArtifactsDir)&quot;" />
    <Message Importance="high" Text="App bundle: $(ArtifactsDir)PickerHelper.app" />
  </Target>

</Project>
