<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- A short-lived dialog: no Dock icon and no menu bar. It still activates itself (docs/Platform.md §3.7). -->
  <key>LSUIElement</key>
  <true/>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>LSMinimumSystemVersion</key>
  <string>12.0</string>
  <!-- The app icon in Contents/Resources (build/AppIcon.targets): Assets.car, and Preferis.icns as the fallback. -->
  <key>CFBundleIconFile</key>
  <string>Preferis</string>
  <key>CFBundleIconName</key>
  <string>Preferis</string>
  <!-- Deliberately no CFBundleURLTypes: Launch Services must route URLs only to the main Preferis bundle. -->
  <!--
    The languages of the UI (docs/Design.md §9.4). Without them AppKit shows its own texts (such as the accessibility
    descriptions of the controls) in English whatever the system language.
  -->
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleLocalizations</key>
  <array>
    <string>en</string>
    <string>ja</string>
  </array>
</dict>
</plist>
