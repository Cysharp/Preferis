<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      Windows: a GUI program, so that no console window flashes up whenever a link is clicked. Its commands borrow the
      terminal's console instead (WindowsProcess.AttachToParentConsole).
    -->
    <OutputType Condition="$([MSBuild]::IsOSPlatform('Windows'))">WinExe</OutputType>
    <AssemblyName>Preferis</AssemblyName>
    <RootNamespace>Preferis.Router</RootNamespace>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <ApplicationManifest>Windows/app.manifest</ApplicationManifest>
    <!-- The app icon, shared with the picker and the settings; Preferis.png next to this project is its source (docs/Platform.md §2.7). -->
    <ApplicationIcon Condition="$([MSBuild]::IsOSPlatform('Windows'))">Windows/Preferis.ico</ApplicationIcon>
    <Description>Preferis router: receives URLs, routes them and launches the browser. No UI framework.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Preferis.Core/Preferis.Core.csproj" />
    <ProjectReference Include="../Preferis.Platform/Preferis.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="macOS/Info.plist" />
  </ItemGroup>

</Project>
