<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Preferis</AssemblyName>
    <RootNamespace>Preferis.Router</RootNamespace>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <Description>Preferis router: receives URLs, routes them and launches the browser. No UI framework.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Preferis.Core/Preferis.Core.csproj" />
    <ProjectReference Include="../Preferis.Platform/Preferis.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="macOS/Info.plist" />
  </ItemGroup>

</Project>
