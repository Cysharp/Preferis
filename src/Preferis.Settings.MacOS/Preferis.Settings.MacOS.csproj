<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The macOS settings UI (docs/Design.md §9.1): AppKit views over the view models of Preferis.Settings.Core.
    Bundled as Preferis.app/Contents/Helpers/Preferis Settings.app. Builds only on macOS (Microsoft.macOS workload).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-macos</TargetFramework>
    <SupportedOSPlatformVersion>12.0</SupportedOSPlatformVersion>
    <!-- Microsoft.macOS defaults to a universal (arm64 + x64) build; NativeAOT cannot produce one, so build one RID at a time. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <RootNamespace>Preferis.Settings.MacOS</RootNamespace>
    <AssemblyName>Preferis Settings</AssemblyName>
    <ApplicationTitle>Preferis Settings</ApplicationTitle>
    <ApplicationId>net.mayuki.Preferis.Settings</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <!-- Microsoft.macOS creates an installer .pkg on publish by default; only the .app is wanted. -->
    <CreatePackage>false</CreatePackage>
    <Description>Preferis settings for macOS: edit profiles and routing rules.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Preferis.Settings.Core/Preferis.Settings.Core.csproj" />
  </ItemGroup>

  <Import Project="../../build/AppManifest.targets" />

</Project>
