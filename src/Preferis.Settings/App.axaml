<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Preferis.Settings.ViewModels"
             xmlns:views="using:Preferis.Settings.Views"
             x:Class="Preferis.Settings.App"
             Name="Preferis Settings"
             RequestedThemeVariant="Default">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="SidebarBrush" Color="#0A000000" />
          <SolidColorBrush x:Key="CardBrush" Color="#06000000" />
          <SolidColorBrush x:Key="CardBorderBrush" Color="#1A000000" />
          <SolidColorBrush x:Key="SeparatorBrush" Color="#1A000000" />
          <SolidColorBrush x:Key="BannerBrush" Color="#FFF4CE" />
          <SolidColorBrush x:Key="SelectedBrush" Color="#1F0067C0" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="SidebarBrush" Color="#14FFFFFF" />
          <SolidColorBrush x:Key="CardBrush" Color="#0AFFFFFF" />
          <SolidColorBrush x:Key="CardBorderBrush" Color="#24FFFFFF" />
          <SolidColorBrush x:Key="SeparatorBrush" Color="#24FFFFFF" />
          <SolidColorBrush x:Key="BannerBrush" Color="#433519" />
          <SolidColorBrush x:Key="SelectedBrush" Color="#3360CDFF" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <views:PngToBitmapConverter x:Key="PngToBitmap" />
      <views:IssueBrushConverter x:Key="IssueBrush" />
    </ResourceDictionary>
  </Application.Resources>

  <!-- Every drop-down entry is a Choice; browsers also show their icon. -->
  <Application.DataTemplates>
    <DataTemplate DataType="vm:BrowserChoice">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Image Width="16" Height="16" Source="{Binding IconPng, Converter={StaticResource PngToBitmap}}" />
        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="vm:Choice">
      <TextBlock Text="{Binding Title}" />
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme DensityStyle="Compact" />

    <Style Selector="TextBlock.heading">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,6,0,0" />
    </Style>
    <Style Selector="TextBlock.secondary, SelectableTextBlock.secondary">
      <Setter Property="Opacity" Value="0.65" />
    </Style>
    <Style Selector="TextBlock.small, SelectableTextBlock.small">
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="TextBox.code">
      <Setter Property="FontFamily" Value="Menlo, Consolas, monospace" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.code">
      <Setter Property="FontFamily" Value="Menlo, Consolas, monospace" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="ListBox.list">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="ListBox.list ListBoxItem">
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.icon">
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="MinWidth" Value="28" />
    </Style>
  </Application.Styles>
</Application>
