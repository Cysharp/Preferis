<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The settings UI (docs/Design.md §9.1): Avalonia, one implementation for Windows and macOS. Not on the
    Router's fast path, so it may enumerate every browser and profile and load icons.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Preferis.Settings</RootNamespace>
    <AssemblyName>Preferis.Settings</AssemblyName>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Description>Preferis settings: edit profiles and routing rules.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Preferis.Core/Preferis.Core.csproj" />
    <ProjectReference Include="../Preferis.Platform/Preferis.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Preferis.Settings.Tests" />
    <None Include="macOS/Info.plist" />
  </ItemGroup>

</Project>
