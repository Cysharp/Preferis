<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Preferis.Settings.ViewModels"
             xmlns:config="using:Preferis.Core.Configuration"
             x:Class="Preferis.Settings.Views.ProfilesPage"
             x:DataType="vm:ProfilesPageViewModel">

  <Grid ColumnDefinitions="310,24,*">
    <!-- Left: configured profiles, then the browsers found on this machine -->
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">
      <TextBlock Classes="heading" Text="Profiles" />
      <TextBlock Grid.Row="1" Classes="secondary" TextWrapping="Wrap" Margin="0,2,0,8"
                 Text="What a URL can be opened with: a browser, one of its profiles, or any command." />

      <ListBox Grid.Row="2" Classes="list" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" MinHeight="120">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ProfileViewModel">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
              <Image Width="24" Height="24" VerticalAlignment="Center"
                     Source="{Binding IconPng, Converter={StaticResource PngToBitmap}}" />
              <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="secondary small" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" Fill="#E5484D" IsVisible="{Binding HasIssues}" ToolTip.Tip="This profile has problems" />
                <Border CornerRadius="4" Padding="5,1" Background="{DynamicResource SelectedBrush}" IsVisible="{Binding IsDefault}">
                  <TextBlock Classes="small" Text="Default" />
                </Border>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Grid Grid.Row="3" Margin="0,8,0,0" ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button Content="+ Command" Command="{Binding AddCommandProfileCommand}" ToolTip.Tip="Add a profile that runs a program with the URL" />
          <Button Content="Duplicate" Command="{Binding DuplicateCommand}" />
          <Button Content="Delete" Command="{Binding DeleteCommand}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
          <Button Classes="icon" Content="↑" Command="{Binding MoveUpCommand}" ToolTip.Tip="Move up (the picker lists profiles in this order)" />
          <Button Classes="icon" Content="↓" Command="{Binding MoveDownCommand}" ToolTip.Tip="Move down" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto" Margin="0,16,0,6">
        <TextBlock Classes="section" Text="Browsers on this computer" VerticalAlignment="Center" Margin="0" />
        <Button Grid.Column="1" Content="Add All" Command="{Binding AddAllDetectedCommand}" Margin="0,0,4,0"
                ToolTip.Tip="Adds a profile for every browser and browser profile that has none yet" />
        <Button Grid.Column="2" Classes="icon" Content="⟳" Command="{Binding RefreshBrowsersCommand}" ToolTip.Tip="Detect browsers again" />
      </Grid>
      <ScrollViewer Grid.Row="5" MaxHeight="250">
        <ItemsControl ItemsSource="{Binding DetectedBrowsers}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:DetectedBrowserViewModel">
              <StackPanel Margin="0,0,0,8">
                <ItemsControl ItemsSource="{Binding Items}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DetectedItemViewModel">
                      <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                        <Panel Width="24" Height="24" VerticalAlignment="Center">
                          <Image Source="{Binding Browser.IconPng, Converter={StaticResource PngToBitmap}}"
                                 IsVisible="{Binding Profile, Converter={x:Static ObjectConverters.IsNull}}" />
                          <Image Width="20" Height="20" Margin="16,0,0,0" Source="{Binding AvatarPng, Converter={StaticResource PngToBitmap}}"
                                 IsVisible="{Binding Profile, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </Panel>
                        <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="secondary small" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis"
                                     IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="Add" VerticalAlignment="Center"
                                Command="{Binding $parent[UserControl].((vm:ProfilesPageViewModel)DataContext).AddDetectedCommand}"
                                CommandParameter="{Binding}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="secondary small" TextWrapping="Wrap" Text="{Binding Note}"
                           IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <!-- Right: the selected profile -->
    <ContentControl Grid.Column="2" Content="{Binding SelectedProfile}">
      <ContentControl.DataTemplates>
        <DataTemplate DataType="vm:ProfileViewModel">
          <ScrollViewer>
            <StackPanel Spacing="8" MaxWidth="620" HorizontalAlignment="Left" Margin="0,0,16,16">
              <Grid ColumnDefinitions="Auto,*">
                <Image Width="40" Height="40" Margin="0,0,12,0" Source="{Binding IconPng, Converter={StaticResource PngToBitmap}}" />
                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBox Text="{Binding Name}" FontSize="18" PlaceholderText="Name" />
                  <SelectableTextBlock Classes="secondary small" Text="{Binding Id, StringFormat='Id: {0} (used by rules; it does not change when you rename)'}" />
                </StackPanel>
              </Grid>

              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="★ Default profile: used when a rule does not name one" VerticalAlignment="Center" IsVisible="{Binding IsDefault}" />
                <Button Content="Make This the Default Profile" IsVisible="{Binding !IsDefault}"
                        Command="{Binding $parent[UserControl].((vm:ProfilesPageViewModel)DataContext).SetDefaultCommand}" />
              </StackPanel>

              <ItemsControl ItemsSource="{Binding Issues}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="config:ConfigIssue">
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{Binding Severity, Converter={StaticResource IssueBrush}}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Classes="section" Text="Opens with" />
              <ComboBox ItemsSource="{Binding TargetKinds}" SelectedItem="{Binding TargetKind}" MinWidth="200" />

              <!-- Browser -->
              <StackPanel Spacing="8" IsVisible="{Binding IsBrowser}">
                <ComboBox ItemsSource="{Binding BrowserChoices}" SelectedItem="{Binding Browser}" MinWidth="320"
                          PlaceholderText="Choose a browser" IsVisible="{Binding !PerOs}" />
                <CheckBox Content="Use a different browser on each OS (for a configuration shared with Windows)" IsChecked="{Binding PerOs}" />
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" IsVisible="{Binding PerOs}" RowSpacing="6" ColumnSpacing="8">
                  <TextBlock Text="macOS" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding BrowserChoices}" SelectedItem="{Binding MacOSBrowser}" MinWidth="300" />
                  <TextBlock Grid.Row="1" Text="Windows" VerticalAlignment="Center" />
                  <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding WindowsBrowserChoices}" SelectedItem="{Binding WindowsBrowser}" MinWidth="300" />
                </Grid>

                <TextBlock Classes="section" Text="Browser profile" IsVisible="{Binding HasBrowserProfiles}" />
                <ComboBox ItemsSource="{Binding BrowserProfileChoices}" SelectedItem="{Binding BrowserProfile}" MinWidth="320"
                          IsVisible="{Binding HasBrowserProfiles}" />

                <CheckBox Content="Open in a private window" IsChecked="{Binding Private}" />

                <TextBlock Classes="section" Text="Extra arguments" />
                <TextBox Classes="code" Text="{Binding ExtraArgs}" AcceptsReturn="True" MinHeight="56" PlaceholderText="One per line, e.g. --new-window" />
              </StackPanel>

              <!-- Command -->
              <StackPanel Spacing="8" IsVisible="{Binding IsCommand}">
                <TextBlock Classes="secondary" TextWrapping="Wrap"
                           Text="Runs a program with the URL. {url} in the arguments is replaced with the URL; without it the URL is added at the end." />
                <TextBlock Classes="section" Text="macOS" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                  <TextBox Classes="code" Text="{Binding MacOSCommandPath}" PlaceholderText="/Applications/Foo.app/Contents/MacOS/Foo" />
                  <Button Grid.Column="1" Content="Choose…" Command="{Binding BrowseMacOSCommandCommand}" />
                </Grid>
                <TextBox Classes="code" Text="{Binding MacOSCommandArgs}" AcceptsReturn="True" MinHeight="56" PlaceholderText="Arguments, one per line" />
                <TextBlock Classes="section" Text="Windows" />
                <TextBox Classes="code" Text="{Binding WindowsCommandPath}" PlaceholderText="%LOCALAPPDATA%\Programs\Foo\foo.exe" />
                <TextBox Classes="code" Text="{Binding WindowsCommandArgs}" AcceptsReturn="True" MinHeight="56" PlaceholderText="Arguments, one per line" />
              </StackPanel>

              <TextBlock Classes="section" Text="When this profile is not available" />
              <TextBlock Classes="secondary small" TextWrapping="Wrap"
                         Text="For example when the browser is not installed on another computer that shares this configuration." />
              <ComboBox ItemsSource="{Binding FallbackChoices}" SelectedItem="{Binding Fallback}" MinWidth="320" />
            </StackPanel>
          </ScrollViewer>
        </DataTemplate>
      </ContentControl.DataTemplates>
    </ContentControl>

    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6"
                IsVisible="{Binding SelectedProfile, Converter={x:Static ObjectConverters.IsNull}}">
      <TextBlock Classes="heading" Text="No profile selected" HorizontalAlignment="Center" />
      <TextBlock Classes="secondary" TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center"
                 Text="Add the browsers found on this computer from the list on the left, or add a command." />
    </StackPanel>
  </Grid>
</UserControl>
