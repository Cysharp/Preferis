<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Preferis.Settings.ViewModels"
             x:Class="Preferis.Settings.Views.TestPage"
             x:DataType="vm:TestPageViewModel">

  <ScrollViewer>
    <StackPanel Spacing="10" MaxWidth="860" HorizontalAlignment="Left" Margin="0,0,16,16">
      <TextBlock Classes="heading" Text="Test" />
      <TextBlock Classes="secondary" TextWrapping="Wrap"
                 Text="Shows how a URL would be routed with the configuration being edited, unsaved changes included. Nothing is opened." />

      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBox Classes="code" Text="{Binding Url}" PlaceholderText="https://www.example.com/">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding RunCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <Button Grid.Column="1" Classes="accent" Content="Test" Command="{Binding RunCommand}" />
      </Grid>
      <TextBlock Text="{Binding Error}" Foreground="#E5484D" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

      <StackPanel Spacing="8" IsVisible="{Binding HasResult}">
        <Border Classes="card">
          <StackPanel Spacing="6">
            <SelectableTextBlock Text="{Binding Decision}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <SelectableTextBlock Classes="code secondary" TextWrapping="Wrap" Text="{Binding RoutedUrl, StringFormat='URL after rewriting: {0}'}"
                                 IsVisible="{Binding RoutedUrl, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <ItemsControl ItemsSource="{Binding Candidates}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CandidateLine">
                  <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Text="✓" Foreground="#30A46C" IsVisible="{Binding IsResolved}" Margin="0,0,8,0" />
                    <TextBlock Text="!" Foreground="#D98E04" FontWeight="Bold" IsVisible="{Binding !IsResolved}" Margin="2,0,10,0" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Name}" />
                      <SelectableTextBlock Classes="code secondary small" Text="{Binding Detail}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <TextBlock Classes="section" Text="Steps" />
        <ItemsControl ItemsSource="{Binding Trace}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TraceLine">
              <Grid ColumnDefinitions="90,220,*" ColumnSpacing="8" Margin="0,2">
                <TextBlock Classes="secondary small" Text="{Binding Kind}" />
                <TextBlock Grid.Column="1" Classes="small" Text="{Binding Rule}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Rule}" />
                <SelectableTextBlock Grid.Column="2" Classes="small" Text="{Binding Message}" TextWrapping="Wrap" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel Spacing="6" IsVisible="{Binding IsHistoryEnabled}" Margin="0,12,0,0">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="section" Text="Recently opened" VerticalAlignment="Center" Margin="0" />
          <Button Grid.Column="1" Content="Clear History" Command="{Binding ClearHistoryCommand}" />
        </Grid>
        <TextBlock Classes="secondary small" Text="Nothing yet." IsVisible="{Binding !History.Count}" />
        <ItemsControl ItemsSource="{Binding History}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:HistoryLine">
              <Grid ColumnDefinitions="140,*,Auto,Auto" Margin="0,1" ColumnSpacing="8">
                <TextBlock Classes="secondary small" Text="{Binding Time}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="code small" Text="{Binding Url}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Url}" />
                <TextBlock Grid.Column="2" Classes="secondary small" Text="{Binding Rule}" VerticalAlignment="Center" />
                <Button Grid.Column="3" Content="Test" Classes="icon"
                        Command="{Binding $parent[UserControl].((vm:TestPageViewModel)DataContext).TestHistoryEntryCommand}" CommandParameter="{Binding}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
